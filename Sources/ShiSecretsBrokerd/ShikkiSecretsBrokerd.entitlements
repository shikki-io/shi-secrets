<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- spec 7c2e9a14 vault-lock-per-platform rev 3, W1.
     keychain-access-groups re-added for AppleKeychainCustody (BR-02):
       kSecAttrAccessibleWhenUnlockedThisDeviceOnly in the data protection
       Keychain requires this entitlement on a team-signed binary.
       Binary must be signed with SH7MZH647S (Apple Distribution: OBYW.ONE).
       See scripts/sign-shi-secrets-brokerd.sh.

     #202 note: the old entry (io.shikki.vault) was removed because the
     keychain-access-groups was *unregistered* in the Portal, causing AMFI
     OS_REASON_EXEC failure. The new entry io.shikki.vault-key
     must be registered in the Apple Developer Portal under App ID
     io.shikki.secrets-brokerd before shipping.

     Portal registration prerequisite:
       1. Login to developer.apple.com → Certificates, IDs & Profiles
       2. App IDs → io.shikki.secrets-brokerd → Edit
       3. Keychain Sharing → Add Group: io.shikki.vault-key
       4. Download and install the updated provisioning profile
-->
<dict>
    <key>keychain-access-groups</key>
    <array>
        <!-- Vault key custody group — AppleKeychainCustody default service.
             Must be registered in Apple Developer Portal before shipping. -->
        <string>SH7MZH647S.io.shikki.vault-key</string>
    </array>
</dict>
</plist>
